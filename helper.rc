#include <winver.h>

1 VERSIONINFO
 FILEVERSION     1,0,0,0
 PRODUCTVERSION  1,0,0,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Clipboard History Manager"
            VALUE "FileDescription",  "Native helper for the Clipboard History Manager browser extension"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "clipboard-history-helper"
            VALUE "LegalCopyright",   "https://github.com/lunu-bounir/clipboard-helper"
            VALUE "OriginalFilename", "clipboard-history-helper.exe"
            VALUE "ProductName",      "Clipboard History Manager"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
